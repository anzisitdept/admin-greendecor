rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function ownProfile(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------
    // users
    // ---------------------------------------------------------------------
    match /users/{uid} {
      // Admins need the unfiltered list for the Users panel. A query over the
      // whole collection cannot be proven to satisfy `ownProfile`, so without
      // this clause the admin read is rejected outright.
      allow read: if ownProfile(uid) || isAdmin();
      // A visitor may create their own profile, but must never mint themselves
      // an admin role, and must never promote or re-enable themselves later.
      // Otherwise anyone could self-register as admin and then list every
      // document in the database.
      allow create: if isAdmin()
        || (ownProfile(uid) && request.resource.data.role != 'admin');
      allow update: if isAdmin()
        || (ownProfile(uid)
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['role', 'status']));
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Public catalog (readable by everyone, writable by admins only)
    // ---------------------------------------------------------------------
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Gallery (public gallery page)
    //   - readable by everyone: the storefront renders its filter tabs and
    //     project cards from these documents for anonymous visitors
    //   - writable by admins only
    // ---------------------------------------------------------------------
    match /galleryProjects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /galleryCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Shop categories
    //   - readable by everyone: the storefront renders its category filter
    //     from these documents, and the catalog must be correct for anonymous
    //     visitors too
    //   - writable by admins only, so categories cannot be injected from a
    //     public browser
    // ---------------------------------------------------------------------
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Reviews (submitted from the public site)
    //   - anyone may submit; must start as 'pending'
    //   - public read is limited to approved + general (they render live)
    //   - admins read all (private feedback) and moderate the status
    // ---------------------------------------------------------------------
    match /reviews/{id} {
      function validNewReview() {
        return request.resource.data.status == 'pending' &&
          request.resource.data.type in ['private', 'general'] &&
          request.resource.data.authorName is string &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0;
      }

      allow create: if validNewReview();
      allow read: if isAdmin() || (resource.data.status == 'approved' && resource.data.type == 'general');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Coupons
    //   - the storefront cart queries these by code, so reads stay public
    //   - writes are admin-only: anonymous visitors must never be able to
    //     mint a coupon, they go through the server-side welcome endpoint
    //   - the guard pins the exact shape the cart validator reads, so a
    //     malformed doc can never reach checkout
    // ---------------------------------------------------------------------
    match /coupons/{id} {
      function validCoupon() {
        let d = request.resource.data;
        return d.code is string && d.code.size() > 0 && d.code.size() <= 40 &&
          d.type in ['percent', 'flat'] &&
          d.value is number && d.value > 0 &&
          (d.type != 'percent' || d.value <= 100) &&
          d.minOrder is number && d.minOrder >= 0 &&
          d.active is bool &&
          d.usedCount is number && d.usedCount >= 0 &&
          (!('usageLimit' in d) || (d.usageLimit is number && d.usageLimit > 0)) &&
          (!('expiresAt' in d) || d.expiresAt is string) &&
          // These documents are world-readable, so claimant PII is banned here
          // outright. It belongs in welcomeSubscribers, which is admin-only.
          !('contact' in d) && !('email' in d);
      }

      allow read: if true;
      allow create: if isAdmin() && validCoupon();
      allow update: if isAdmin() && validCoupon();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Welcome popup signups (contains phone numbers + IP hashes)
    //   - never public: no read, no write, admins only
    //   - the storefront mints these server-side via the admin SDK, which
    //     bypasses these rules entirely
    // ---------------------------------------------------------------------
    match /welcomeSubscribers/{id} {
      function validSubscriber() {
        let d = request.resource.data;
        return d.contact is string && d.contact.size() > 0 &&
          d.code is string && d.code.size() > 0 &&
          d.status in ['active', 'used', 'expired'];
      }

      allow read: if isAdmin();
      allow create: if isAdmin() && validSubscriber();
      allow update: if isAdmin() && validSubscriber();
      allow delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteContent/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Orders
    //   - admins read/write all
    //   - signed-in customers read + create their own
    //   - guests may create an order tagged userId == 'guest' (checkout)
    // ---------------------------------------------------------------------
    match /orders/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
        (!isSignedIn() && request.resource.data.userId == 'guest');
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Service requests + contact inquiries
    //   - anyone may submit (create)
    //   - admins read/write
    // ---------------------------------------------------------------------
    match /serviceRequests/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /contactInquiries/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Everything else: deny by default (safe fallback)
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}